# Umgebung der Unit-Tests (npm run test:unit / test:coverage, per --env-file). Werte aus der echten Umgebung gehen vor.
# Die Docker-Sandbox ist im Betrieb Standard; Unit-Tests arbeiten mit Attrappen statt Docker. Tests der Sandbox selbst
# geben ihre Umgebung ausdrücklich vor, die Integrationstests (sandbox-docker.test.ts) nutzen echtes Docker.
DEV_LOG_AGENT_SANDBOX=docker
