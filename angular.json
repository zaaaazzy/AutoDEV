{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dev-log": {
      "projectType": "application",
      "root": "frontend",
      "sourceRoot": "frontend/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/ui",
            "index": "frontend/src/index.html",
            "browser": "frontend/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "frontend/tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [],
            "styles": [
              "frontend/src/styles/01-base.css",
              "frontend/src/styles/02-shell.css",
              "frontend/src/styles/03-components.css",
              "frontend/src/styles/04-responsive.css",
              "frontend/src/styles/05-widgets.css",
              "frontend/src/styles/06-git-timeline.css",
              "frontend/src/styles/07-views.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dev-log:build:production"
            },
            "development": {
              "buildTarget": "dev-log:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "::development",
            "tsConfig": "frontend/tsconfig.spec.json",
            "runner": "vitest"
          }
        }
      }
    }
  }
}
