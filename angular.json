{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dev-log": {
      "projectType": "application",
      "root": "frontend",
      "sourceRoot": "frontend/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ui",
            "index": "frontend/src/index.html",
            "browser": "frontend/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "frontend/tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "frontend/public"
              }
            ],
            "styles": [
              "frontend/src/styles/01-base.css",
              "frontend/src/styles/02-layout.css",
              "frontend/src/styles/03-buttons-forms.css",
              "frontend/src/styles/04-components.css",
              "frontend/src/styles/05-tables.css",
              "frontend/src/styles/06-dialogs.css",
              "frontend/src/styles/07-setup-wizard.css",
              "frontend/src/styles/08-orders.css",
              "frontend/src/styles/09-dashboard.css",
              "frontend/src/styles/10-ideas.css",
              "frontend/src/styles/11-chat.css",
              "frontend/src/styles/12-sprints.css",
              "frontend/src/styles/13-docs.css",
              "frontend/src/styles/14-agents.css",
              "frontend/src/styles/15-tests.css",
              "frontend/src/styles/16-bugs.css",
              "frontend/src/styles/17-settings.css"
            ],
            "allowedCommonJsDependencies": [
              "cytoscape-fcose",
              "cytoscape-cose-bilkent",
              "@braintree/sanitize-url",
              "dayjs",
              "fastdom"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "950kB",
                  "maximumError": "1.1MB"
                },
                {
                  "type": "bundle",
                  "name": "styles",
                  "maximumWarning": "185kB",
                  "maximumError": "200kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dev-log:build:production"
            },
            "development": {
              "buildTarget": "dev-log:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
