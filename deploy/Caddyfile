# HTTPS-Zugang zu AIdeation: Caddy holt das Zertifikat bei Let's Encrypt
# (Router muss dafür Port 443 an diesen Rechner weiterleiten) und
# leitet die Anfragen an das Frontend (aideation_frontend_angular) weiter, das selbst nur intern bzw. lokal lauscht.
{$DEV_LOG_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	# Caddy setzt X-Forwarded-For selbst auf die echte Client-IP und verwirft einen mitgeschickten Wert (ohne
	# trusted_proxies). Port 8081 von nginx übernimmt diese IP und reicht genau sie weiter; das Backend vertraut
	# einem Hop (DEV_LOG_TRUST_PROXY=1). So zählen Fehlversuche je Client statt für alle gemeinsam.
	# Nicht 8080: dort gilt die Socket-Adresse, sonst sähen alle Nutzer die Adresse von Caddy.
	reverse_proxy frontend:8081
}
