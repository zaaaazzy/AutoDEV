# HTTPS-Zugang zu AIdeation: Caddy holt das Zertifikat bei Let's Encrypt
# (Router muss dafür Port 443 an diesen Rechner weiterleiten) und
# leitet die Anfragen an das Frontend (aideation_frontend_angular) weiter, das selbst nur intern bzw. lokal lauscht.
{$DEV_LOG_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	# Caddy setzt X-Forwarded-For selbst auf die echte Client-IP und verwirft einen mitgeschickten Wert (ohne
	# trusted_proxies). nginx hängt seine Sicht an, das Backend glaubt nur Proxys aus DEV_LOG_TRUST_PROXY (uniquelocal).
	# So zählen Fehlversuche je Client statt für alle gemeinsam unter der Proxy-Adresse.
	reverse_proxy frontend:8080
}
