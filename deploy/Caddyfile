# HTTPS-Zugang zu AIdeation: Caddy holt das Zertifikat bei Let's Encrypt
# (Router muss dafür Port 443 an diesen Rechner weiterleiten) und
# leitet die Anfragen an das Frontend (aideation_frontend_angular) weiter, das selbst nur intern bzw. lokal lauscht.
{$DEV_LOG_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:8080
}
