{
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "include": [
    "src/**/*.ts",
    "../src/core/layout-measure.ts",
    "../src/core/cron.ts",
    "../src/core/development-transitions.ts",
    "../src/core/sprint-rules.ts"
  ],
  "exclude": ["src/**/*.spec.ts"]
}
