{
  "name": "dev-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "ng build --configuration production",
    "start": "node dist/server.js",
    "dev": "tsx watch src/dev-server.ts",
    "dev:ui": "ng serve --proxy-config frontend/proxy.conf.json",
    "lint": "eslint . && tsx scripts/check-layers.ts",
    "format": "prettier --write src frontend/src",
    "format:check": "prettier --check src frontend/src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p frontend/tsconfig.spec.json --noEmit",
    "test": "npm run build:ui && npm run test:unit",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"frontend/src/**/*.spec.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=**/*.test.ts --test-coverage-exclude=**/*.spec.ts --test-coverage-exclude=**/node_modules/** \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"frontend/src/**/*.spec.ts\"",
    "test-agent": "tsx src/runner/test-agent.ts",
    "runner": "tsx src/runner/runner-cli.ts",
    "worker": "tsx src/runner/runner-cli.ts --all --watch --limit 3",
    "watchdog": "tsx src/runner/watchdog-cli.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:full": "tsx scripts/test-full.ts",
    "check:styles": "playwright test -c e2e/styles.config.ts",
    "check:diagrams": "tsx scripts/check-diagrams.ts"
  },
  "dependencies": {
    "@tanstack/angular-table": "^9.3.1",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "pngjs": "^7.0.0",
    "qrcode": "1.5.4",
    "undici": "^8.12.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "eslint": "^10.13.0",
    "mermaid": "11.17.2",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "zone.js": "^0.16.3"
  }
}
